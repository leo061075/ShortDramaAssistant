<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/proto_bg" android:orientation="vertical">
    <LinearLayout android:id="@+id/settingsHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_page_dark_header" android:orientation="vertical"
        android:paddingLeft="14dp" android:paddingRight="14dp"
        android:paddingTop="12dp" android:paddingBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnSettingsBack"
                android:layout_width="38dp" android:layout_height="38dp"
                android:background="@android:color/transparent" android:contentDescription="返回"
                android:src="@drawable/ic_back_white" android:padding="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:text="识别字段设置"
                android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <Space android:layout_width="38dp" android:layout_height="38dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center"
            android:text="自定义短剧、广告和继续观看提示词"
            android:textColor="#C8E7FF" android:textSize="12sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="8dp" android:text="修改后点击保存，立即应用于 OCR 和无障碍识别。多条关键词每行填写一条。"
                android:textSize="12sp" android:textColor="@color/proto_muted" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_proto_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="当前集数格式" android:textColor="@color/proto_text"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="示例：第{n}集，{n} 表示 1～4 位集数数字"
                    android:textColor="@color/proto_muted" android:textSize="11sp" />
                <EditText android:id="@+id/etEpisodePattern"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:background="@drawable/bg_settings_field"
                    android:inputType="textNoSuggestions" android:gravity="top|start"
                    android:minLines="1" android:maxLines="1"
                    android:padding="11dp" android:textColor="@color/proto_text"
                    android:textColorHint="@color/proto_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_proto_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="总集数格式" android:textColor="@color/proto_text"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="示例：{n}集全，用于确认正常短剧页面"
                    android:textColor="@color/proto_muted" android:textSize="11sp" />
                <EditText android:id="@+id/etTotalPattern"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:background="@drawable/bg_settings_field"
                    android:inputType="textNoSuggestions" android:gravity="top|start"
                    android:minLines="1" android:maxLines="1"
                    android:padding="11dp" android:textColor="@color/proto_text"
                    android:textColorHint="@color/proto_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_proto_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="短剧标识词" android:textColor="@color/proto_text"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="至少保留一条；与当前集数、总集数同时命中时认定为正常页"
                    android:textColor="@color/proto_muted" android:textSize="11sp" />
                <EditText android:id="@+id/etDramaLabels"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:background="@drawable/bg_settings_field"
                    android:inputType="textMultiLine|textNoSuggestions" android:gravity="top|start"
                    android:minLines="2" android:maxLines="7"
                    android:padding="11dp" android:textColor="@color/proto_text"
                    android:textColorHint="@color/proto_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_proto_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="主要广告识别词" android:textColor="@color/proto_text"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="出现任意一条即可识别为广告；建议保留“秒后可解锁付费集”"
                    android:textColor="@color/proto_muted" android:textSize="11sp" />
                <EditText android:id="@+id/etPrimaryAd"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:background="@drawable/bg_settings_field"
                    android:inputType="textMultiLine|textNoSuggestions" android:gravity="top|start"
                    android:minLines="2" android:maxLines="7"
                    android:padding="11dp" android:textColor="@color/proto_text"
                    android:textColorHint="@color/proto_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_proto_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="辅助广告识别词" android:textColor="@color/proto_text"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="同时命中两条时作为广告证据；可留空"
                    android:textColor="@color/proto_muted" android:textSize="11sp" />
                <EditText android:id="@+id/etAuxiliaryAd"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:background="@drawable/bg_settings_field"
                    android:inputType="textMultiLine|textNoSuggestions" android:gravity="top|start"
                    android:minLines="2" android:maxLines="7"
                    android:padding="11dp" android:textColor="@color/proto_text"
                    android:textColorHint="@color/proto_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_proto_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="广告结束 / 继续观看提示" android:textColor="@color/proto_text"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="识别到任意一条可触发自动上滑，建议不要使用过短的通用词"
                    android:textColor="@color/proto_muted" android:textSize="11sp" />
                <EditText android:id="@+id/etContinuePrompt"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:background="@drawable/bg_settings_field"
                    android:inputType="textMultiLine|textNoSuggestions" android:gravity="top|start"
                    android:minLines="2" android:maxLines="7"
                    android:padding="11dp" android:textColor="@color/proto_text"
                    android:textColorHint="@color/proto_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <Button android:id="@+id/btnResetRules"
                    android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                    android:background="@drawable/bg_proto_card" android:backgroundTint="@null"
                    android:text="恢复默认" android:textAllCaps="false" android:textColor="@color/proto_text"
                    android:textSize="14sp" />
                <Space android:layout_width="10dp" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnSettingsSave"
                    android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="2"
                    android:background="@drawable/bg_proto_primary" android:backgroundTint="@null"
                    android:text="保存识别字段" android:textAllCaps="false" android:textColor="@android:color/white"
                    android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:padding="4dp"
                android:text="自动上滑的防重复保护和补滑次数保持不变。"
                android:textColor="@color/proto_muted" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
