<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_proto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="9dp"
    android:paddingTop="4dp"
    android:paddingRight="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvFloatingStatus"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dragHandle"
        android:layout_width="26dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:contentDescription="拖动悬浮窗"
        android:text="⋮⋮"
        android:textColor="#B8C8EA"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/btnFloatingStop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_overlay_stop_active"
        android:contentDescription="停止跳广告"
        android:padding="14dp"
        android:src="@drawable/ic_control_stop" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:text="停止"
        android:textColor="@android:color/white"
        android:textSize="12sp" />
</LinearLayout>
